# HireMind Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=mysql+mysqlconnector://root:YOUR_PASSWORD@localhost:3306/hiremind

# ── JWT Auth ──────────────────────────────────────────────────────────
SECRET_KEY=hiremind-super-secret-jwt-key-change-me-in-production-2025

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
